# ==============================================================================
# Agnes Zero-Cost Video Generator Environment Configuration
# ==============================================================================
# Copy this file to .env and replace placeholders with real values:
#   cp .env.example .env
#
# NEVER commit the real .env file containing your secret API keys to Git!
# ==============================================================================

# ─── Agnes AI API Credentials (Required) ──────────────────────────────────────
# Obtain your API key from the Agnes AI Platform dashboard:
# https://apihub.agnes-ai.com/
AGNES_API_KEY=your_agnes_api_key_here

# Agnes Base URL (Default: https://apihub.agnes-ai.com/v1)
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ─── Model Configurations ───────────────────────────────────────────────────────
# Text & Storyboard model ($0 / 1M tokens promotional price)
AGNES_TEXT_MODEL=agnes-2.5-flash

# Image generation & editing model ($0 across all resolutions)
AGNES_IMAGE_MODEL=agnes-image-2.0-flash

# Native Video model (Agnes Video 2.5)
AGNES_VIDEO_MODEL=agnes-video-2.5

# Default generation engine: 'zero_cost' (Flash + FFmpeg Ken Burns) or 'native_video' (Agnes Video 2.5)
AGNES_ENGINE=zero_cost

# ─── Video Generation Defaults (Optional) ─────────────────────────────────────
# Default frame resolution: 1024x768 (landscape), 1024x1024 (square), 768x1024 (portrait)
DEFAULT_IMAGE_SIZE=1024x768

# Native Agnes Video defaults
DEFAULT_VIDEO_SECONDS=5
DEFAULT_VIDEO_SIZE=720P
DEFAULT_VIDEO_ASPECT_RATIO=16:9

# Default video frame rate (e.g. 24 or 30)
DEFAULT_FPS=24

# Default duration in seconds per storyboard scene
DEFAULT_SCENE_DURATION=4.0

# Default output directory for storyboards, frames, and final MP4 files
OUTPUT_DIR=output
